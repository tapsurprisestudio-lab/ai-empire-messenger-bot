# ============================================================
# FACEBOOK MESSENGER CHATBOT - ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# ------ REQUIRED CREDENTIALS ------

# Your Facebook Page Access Token
# Get from: Facebook Developer Console > Your App > Messenger > Settings
PAGE_ACCESS_TOKEN=your_page_access_token_here

# Token you choose to verify the webhook (any random string you create)
# Example: mySecretVerifyToken123
VERIFY_TOKEN=your_verify_token_here

# Anthropic Claude API Key
# Get from: https://console.anthropic.com
AI_API_KEY=sk-ant-your-key-here

# ------ SERVER CONFIG ------

PORT=3000
NODE_ENV=production

# ------ AGENCY CONFIG (Customize These) ------

AGENCY_NAME=Your Agency Name
AGENCY_EMAIL=hello@youragency.com
AGENCY_PHONE=+1 (555) 000-0000
AGENCY_WEBSITE=https://youragency.com
AGENCY_CALENDLY=https://calendly.com/youragency

# ------ OPTIONAL: ANALYTICS WEBHOOK ------
# POST leads here (e.g., Zapier, Make, your CRM)
LEADS_WEBHOOK_URL=

# ------ OPTIONAL: SLACK NOTIFICATIONS ------
# Send hot lead alerts to Slack
SLACK_WEBHOOK_URL=

# ------ RATE LIMITING ------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# ------ AI MODEL CONFIG ------
AI_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=1000
